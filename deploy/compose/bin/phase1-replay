#!/usr/bin/env bash
# phase1-replay — prove the minutes lane WITHOUT a live meeting.
#
# Seeds one completed meeting with a speaker-attributed transcript for user 1, checks the gateway
# can read it back, then (unless --seed-only) admits a `meeting.completed` fact into flows-api with
# explicit participants and polls the reaction until it ends. The expected result of a full run is
# three mails in Mailpit: the organizer's minutes plus one per attendee, all carrying the report.
#
# Run on the compose host, from deploy/compose:
#   ./bin/phase1-replay --seed-only      # seed + readability check, no reaction
#   ./bin/phase1-replay                  # seed + admit + wait + list Mailpit
#   REPLAY_UID=7 REPLAY_KEY=vxa_… ./bin/phase1-replay
#                                        # seed the meeting for ANOTHER user, with that user's own
#                                        # gateway key. Defaults to user 1 and ~/api-key.txt. Use
#                                        # it to give a second signed-in account something to look
#                                        # at, or to exercise the per-subject scoping of the
#                                        # minutes projection with more than one person's rows.
#   ./bin/phase1-replay --calendar       # as a CALENDAR meeting: the admitted fact carries NO
#                                        # participants and no names, exactly what meeting-api
#                                        # publishes when a meeting came from an ICS feed rather
#                                        # than an emailed invite (events.meeting_completed_refs).
#                                        # The roster then has to come off the meeting row.
#
# Needs: .env (ADMIN_TOKEN, VEXA_FLOWS_API_KEY), ~/api-key.txt (a bot,tx key for user 1),
#        ~/compose-cmd.txt (the compose command with every override file).
set -euo pipefail

SEED_ONLY=0; [ "${1:-}" = "--seed-only" ] && SEED_ONLY=1
CALENDAR=0; [ "${1:-}" = "--calendar" ] && CALENDAR=1
C=$(cat ~/compose-cmd.txt)
UID_="${REPLAY_UID:-1}"
KEY="${REPLAY_KEY:-$(cat ~/api-key.txt)}"
_envv() { grep -E "^$1=" .env | head -1 | cut -d= -f2- | tr -d '[:space:]'; }
FLOWS_KEY=$(_envv VEXA_FLOWS_API_KEY)
GW=http://127.0.0.1:${API_GATEWAY_HOST_PORT:-18056}
FLOWS=http://127.0.0.1:${FLOWS_API_HOST_PORT:-18200}
MAILPIT=http://127.0.0.1:${MAILPIT_UI_PORT:-18025}
TS=$(date +%s)
NATIVE="replay-${TS}"
TITLE="Q3 pricing review (replay ${TS})"
ORG="${REPLAY_ORG:-ethan@smaltai.com}"
A1="priya@local.test"; A2="marco@local.test"

psql() { $C exec -T postgres psql -U postgres -d vexa -v ON_ERROR_STOP=1 -qtA "$@"; }

echo "→ seeding meeting ${NATIVE} for user ${UID_}"
MID=$(psql -c "INSERT INTO meetings (user_id, platform, platform_specific_id, status, start_time, end_time, data)
VALUES (${UID_}, 'google_meet', '${NATIVE}', 'completed', now() - interval '45 minutes', now() - interval '3 minutes',
 jsonb_build_object('name', '${TITLE}', 'completion_reason', 'replay',
   'attendees', jsonb_build_array(
     jsonb_build_object('email','${ORG}','name','Ethan','partstat','accepted'),
     jsonb_build_object('email','${A1}','name','Priya Raman','partstat','accepted'),
     jsonb_build_object('email','${A2}','name','Marco Bellini','partstat','accepted'))))
RETURNING id;")
echo "  meeting id ${MID}"

# A short, plausible pricing meeting. The grounding gate looks for six-word runs shared between
# the report and this transcript, so the sentences are ordinary prose, not bullet fragments.
python3 - "$MID" <<'PY' | psql >/dev/null
import sys
mid = sys.argv[1]
lines = [
 ("Priya Raman", "Thanks everyone for joining the Q3 pricing review. The main decision today is whether tiered pricing ships on the first of October."),
 ("Marco Bellini", "From the billing side we are ready. The Team tier for five to fifty seats is configured and I can finish the billing config by Wednesday."),
 ("Hannah Lee", "Legal needs to review the updated terms of service before launch. I can have that done by Monday the twenty eighth."),
 ("Priya Raman", "Then we agree tiered pricing launches on the first of October, gated on Legal sign off. I will draft the customer notice by Friday."),
 ("Jonas Weber", "One open question is the partner discount policy with Meridian. I will confirm it with them, no date yet."),
 ("Marco Bellini", "And to be clear, the Enterprise tier stays at forty eight dollars per seat. No grandfathering discussion until Q4."),
 ("Priya Raman", "Agreed. Does the Team tier include single sign on, or is that Enterprise only? We did not settle that."),
 ("Hannah Lee", "Let us leave it as an open question and decide next week. Also, who announces the change to existing monthly customers?"),
 ("Priya Raman", "Marketing owns the announcement. Good, that is everything. Thanks all."),
]
t = 0.0
stmts = []
for i, (spk, text) in enumerate(lines):
    dur = 6.0 + len(text) / 18.0
    safe = text.replace("'", "''")
    stmts.append(f"INSERT INTO transcriptions (meeting_id, start_time, end_time, text, speaker, language, created_at, session_uid, segment_id) "
                 f"VALUES ({mid}, {t:.1f}, {t+dur:.1f}, '{safe}', '{spk}', 'en', now(), 'replay', 'seg-{i}');")
    t += dur + 0.8
print("\n".join(stmts))
PY
N=$(psql -c "select count(*) from transcriptions where meeting_id=${MID};")
echo "  ${N} transcript segments"

echo "→ gateway readability with the user's key"
curl -sf -H "X-API-Key: ${KEY}" "${GW}/transcripts/by-id/${MID}" | python3 -c '
import sys, json
d = json.load(sys.stdin)
segs = d.get("segments") or d.get("transcript") or d
n = len(segs) if isinstance(segs, list) else "?"
print("  gateway returned", n, "segments; first speaker:", (segs[0].get("speaker") if isinstance(segs, list) and segs else "?"))'

if [ "$SEED_ONLY" = 1 ]; then
  echo "✓ seed only — meeting ${MID} is ready for a replay"
  exit 0
fi

SRC="replay-${MID}-${TS}"
if [ "$CALENDAR" = 1 ]; then
  # EXACTLY what meeting-api publishes (events.meeting_completed_refs): no invite, so no
  # participants, no names, no organizer, no title. Everything else must be resolved downstream.
  echo "→ admitting meeting.completed (${SRC}) as a CALENDAR meeting — no participants in the fact"
  REFS='{"uid":"'"${UID_}"'","meeting_id":"'"${MID}"'","native":"'"${NATIVE}"'","platform":"google_meet","completion_reason":"replay"}'
else
  echo "→ admitting meeting.completed (${SRC}) into flows-api"
  REFS='{"uid":"'"${UID_}"'","meeting_id":"'"${MID}"'","native":"'"${NATIVE}"'","platform":"google_meet",
         "organizer":"'"${ORG}"'","title":"'"${TITLE}"'","completion_reason":"replay",
         "participants":["'"${ORG}"'","'"${A1}"'","'"${A2}"'"],
         "participant_names":{"'"${A1}"'":"Priya Raman","'"${A2}"'":"Marco Bellini","'"${ORG}"'":"Ethan"}}'
fi
curl -sf -X POST "${FLOWS}/events" -H "X-Flows-Operator-Key: ${FLOWS_KEY}" -H "Content-Type: application/json" \
  -d "{\"event_type\":\"meeting.completed\",\"source_event_id\":\"${SRC}\",\"refs\":${REFS}}" \
  | python3 -c 'import sys,json; print("  ", json.dumps(json.load(sys.stdin))[:300])'

echo "→ waiting for the post_meeting reaction (up to 15 min)"
for i in $(seq 1 90); do
  STATUS=$(psql -c "select coalesce(status, '?') || ' ' || coalesce(step, '-') || ' ' || coalesce(left(reason, 160), '') from reaction where source_event_id = '${SRC}' and flow = 'post_meeting' order by created_at desc limit 1;")
  echo "  [$((i*10))s] ${STATUS:-no reaction row yet}"
  case "$STATUS" in done*|failed*|not_present*|blocked*) break;; esac
  sleep 10
done

echo "→ Mailpit"
curl -s "${MAILPIT}/api/v1/messages" | python3 -c 'import sys,json
d=json.load(sys.stdin); print("  messages:", d["messages_count"])
for m in d["messages"]: print("   ", m["From"]["Name"], "<"+m["From"]["Address"]+">", "->", m["To"][0]["Address"], "|", m["Subject"])'
